# Only needed for local runs; GitHub Actions uses the ODDS_API_KEY repository secret instead.
# If this file has no key, collect.py also looks in ..\props-test\.env
ODDS_API_KEY=
RUN_CAP=150
RESERVE=40
PROP_MARKETS=player_pass_yds,player_pass_tds,player_rush_yds,player_receptions,player_reception_yds,player_anytime_td
PROP_REGIONS=us
DAYS=8
KALSHI_SERIES=KXNFLGAME
